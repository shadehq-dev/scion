{
  "name": "haunt",
  "version": "0.3.2",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "postinstall": "nuxt prepare",
    "test": "node --test \"sidecar/*.test.ts\" \"shared/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.sidecar.json && nuxt typecheck",
    "check:rust": "cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "app": "tauri dev",
    "app:build": "tauri build"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@nuxt/ui": "^4.12.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "cytoscape": "3.34.3",
    "cytoscape-dagre": "4.0.1",
    "nuxt": "^4.6.2",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/iconoir": "~1.2.12",
    "@iconify-json/material-symbols": "1.2.95",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/tabler": "~1.2.42",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.20.4",
    "vue-tsc": "^3.3.13"
  }
}
